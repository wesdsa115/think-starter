{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"module": "es2022",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"noEmit": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["vite/client"]
	},
	"include": ["src/client.tsx"]
}
